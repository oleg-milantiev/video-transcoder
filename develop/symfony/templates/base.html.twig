<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}Video Transcoder{% endblock %}</title>

        <!-- Favicons -->
        <link rel="icon" type="image/x-icon" href="{{ asset('favicon.ico') }}">
        <link rel="icon" type="image/png" sizes="192x192" href="{{ asset('favicon-192.png') }}">
        <link rel="icon" type="image/png" sizes="512x512" href="{{ asset('favicon-512.png') }}">
        <link rel="apple-touch-icon" href="{{ asset('apple-touch-icon.png') }}">

        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
        <link href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" rel="stylesheet">

        {% block stylesheets %}
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
            <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
        {% endblock %}
    </head>
    <body>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4" style="padding-top: 0px; padding-bottom: 0px">
            <div class="container">
                <a href="{{ path('app_home') }}" title="Video Transcoder">
                    <img src="{{ asset('logo.svg') }}" alt="Video Transcoder" height="60" class="d-inline-block align-text-top">
                    <span class="visually-hidden">Video Transcoder</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav ms-auto">
                        {% if app.user %}
                            {% if is_granted('ROLE_ADMIN') %}
                                <li class="nav-item">
                                    <a class="nav-link text-warning" href="{{ path('admin') }}" data-turbo-prefetch="false">Admin</a>
                                </li>
                            {% endif %}
                            <li class="nav-item">
                                <a class="nav-link text-light" href="{{ path('profile') }}">{{ app.user.userIdentifier }}</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="{{ path('app_logout') }}" data-turbo-prefetch="false">Sign out</a>
                            </li>
                        {% else %}
                            <li class="nav-item">
                                <a class="nav-link" href="{{ path('app_login') }}">Sign in</a>
                            </li>
                        {% endif %}
                    </ul>
                </div>
            </div>
        </nav>

        <div class="container">
            <div class="container">
                <div class="row align-items-center">
                    <div class="col-md-8">
                        <h2 class="fw-bold text-dark mb-2">
                            Video Transcoding <span class="text-primary">in the Cloud</span>
                        </h2>

                        <p class="lead text-secondary mt-3" style="max-width: 500px;">
                            Upload your video. Choose a preset. Get your ready file in minutes.
                            No hardware, no setup — just your browser.
                        </p>
                    </div>

                    <div class="col-md-4 text-center">
                        <svg width="120" height="120" viewBox="0 0 120 120" xmlns="http://www.w3.org/2000/svg">
                            <rect x="20" y="20" width="50" height="50" rx="10" fill="#2563EB" opacity="0.08" stroke="#2563EB" stroke-width="2"/>
                            <rect x="50" y="50" width="50" height="50" rx="10" fill="#06B6D4" opacity="0.08" stroke="#06B6D4" stroke-width="2"/>

                            <defs>
                                <linearGradient id="heroGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                                    <stop offset="0%" stop-color="#2563EB" stop-opacity="0.25"/>
                                    <stop offset="100%" stop-color="#06B6D4" stop-opacity="0.25"/>
                                </linearGradient>
                            </defs>

                            <rect x="50" y="50" width="18" height="28" rx="5" fill="url(#heroGrad)"/>

                            <polygon points="40,35 40,55 56,45" fill="#2563EB" opacity="0.8"/>

                            <path d="M 80 70 L 80 86 M 74 79 L 80 86 L 86 79" stroke="#06B6D4" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
                            <line x1="70" y1="90" x2="90" y2="90" stroke="#06B6D4" stroke-width="1.8" stroke-linecap="round"/>
                        </svg>
                    </div>
                </div>
            </div>

            {% block body %}{% endblock %}

            <footer class="border-top mt-5 py-3">
                <div class="container">
                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                        <div class="small text-secondary">
                            © 2026 Video Transcoder
                        </div>
                        <div class="d-flex flex-wrap gap-3">
{#
                            <a href="#" class="small text-secondary text-decoration-none">Terms</a>
                            <a href="#" class="small text-secondary text-decoration-none">Privacy</a>
#}
                            <a href="{{ path('profile') }}" class="small text-secondary text-decoration-none">Profile</a>
                            <a href="https://deepwiki.com/oleg-milantiev/video-transcoder" class="small text-secondary text-decoration-none">Docs</a>
                            <a href="https://github.com/oleg-milantiev/video-transcoder" class="small text-secondary text-decoration-none">GitHub</a>
{#
                            <a href="#" class="small text-secondary text-decoration-none">Status</a>
#}
                        </div>
                    </div>
                </div>
            </footer>

        </div>
    </body>
</html>
